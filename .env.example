CANVAS_URL=https://westminster.instructure.com
CANVAS_TOKEN=

# Optional: GitHub owner and repo name prefix (defaults match infra/variables.tf).
# Terraform reads the same values via TF_VAR_github_owner and TF_VAR_repo_prefix.
CANVAS_ARCHIVE_GITHUB_OWNER=cruzaddy91
CANVAS_ARCHIVE_REPO_PREFIX=canvas-archive

# Optional: one JSON object per line on stderr (latency, counts, bytes, errors) for later Promtail / Loki / Grafana.
# CANVAS_ARCHIVE_LOG_JSON=1
